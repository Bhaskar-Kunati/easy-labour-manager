# Easy Labour Manager - Environment Variables Example
# Copy this file to .env or export these variables in your shell environment for local development or production.
# DO NOT commit real secrets or credentials to source control.

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/el_db
SPRING_DATASOURCE_USERNAME=el_user
SPRING_DATASOURCE_PASSWORD=password

# JWT & Authentication Secrets
JWT_SECRET=404e635266556a586e3272357538782f413f4428472b4b6250655368566d5971

# Internal Service Secrets
WALLET_INTERNAL_SECRET_KEY=internal-secret-key

# Kafka Configuration
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MongoDB Configuration
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/trackingdb

# Active Spring Profile (set to 'dev' for local development or leave unset/prod for strict fail-fast)
SPRING_PROFILES_ACTIVE=dev
